# ChromaDB Cloud Configuration
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=your_chroma_api_key_here
CHROMA_TENANT=your_chroma_tenant_id_here
CHROMA_DATABASE=BMU_WEBSITE_CHATBOT

# Groq Cloud LLM Configuration
GROQ_API_KEY=your_groq_api_key_here

# Optional: TypeSafe AI Jev API key (falls back to local System-One engine if unset)
TYPESAFE_API_KEY=

# Embedding Model & Retrieval Configuration (Evaluation 2: >1000 Dims)
EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024
CHROMA_COLLECTION_NAME=bmu_bge_knowledge
RETRIEVAL_ENGINE=bge

# Dedicated Agent Groq API Keys (Optional - falls back to GROQ_API_KEY)
GROQ_API_KEY_QUERY_AGENT=
GROQ_MODEL_QUERY_AGENT=openai/gpt-oss-20b
GROQ_API_KEY_CONTEXT_AGENT=
GROQ_MODEL_CONTEXT_AGENT=openai/gpt-oss-20b
GROQ_API_KEY_SYNTHESIS_AGENT=
GROQ_MODEL_SYNTHESIS_AGENT=openai/gpt-oss-120b

# Arize Phoenix AI Observability
PHOENIX_PORT=6006
PHOENIX_HOST=0.0.0.0
PHOENIX_PROJECT_NAME=bmu-website-chatbot
PHOENIX_ENDPOINT=http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# Microservice Ports
PORT=8000
RETRIEVAL_SERVICE_PORT=8001
INGESTION_SERVICE_PORT=8002

